# ==========================================
# Telegram Bot Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Pyrogram MTProto (Required for videos > 20MB/50MB up to 2,000MB / 2GB)
# Obtain from https://my.telegram.org
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID_HERE
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH_HERE

# ==========================================
# AI Model & Speech-to-Text Configuration
# ==========================================
# Google Gemini API Key (Optional for cloud transcription, AI Hook, and Mode 2 scenes)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT=60.0

# Local Faster-Whisper Model (tiny, base, small, medium)
# Used for offline transcription and automatic fallback
WHISPER_MODEL=base
LANGUAGE=km

# ==========================================
# Process Timeouts & Execution (Seconds)
# ==========================================
FFMPEG_TIMEOUT=180.0
REMOTION_RENDER_TIMEOUT=600.0
SUBPROCESS_TIMEOUT=120.0

# ==========================================
# Queue & Concurrency Management
# ==========================================
MAX_CONCURRENT_JOBS=2
MAX_USER_CONCURRENT_JOBS=1
MAX_QUEUE_SIZE=10

# ==========================================
# Retention & Cleanup Policy
# ==========================================
# Hours to retain media and job files while allowing edits/re-renders
JOB_RETENTION_HOURS=24.0
