# ==========================================
# Telegram Bot Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Optional Alias for Telegram Bot Token
# BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ==========================================
# System Binaries & Paths (Optional overrides)
# ==========================================
# Leave empty to automatically use PATH or imageio-ffmpeg
FFMPEG_PATH=
FFPROBE_PATH=

# Local runtime storage directory (Git-ignored)
RUNTIME_DIR=runtime

# Path to redistributable Khmer font
KHMER_FONT_PATH=assets/fonts/KhmerOSbattambang.ttf

# ==========================================
# Resource Limits & Retention
# ==========================================
MAX_MEDIA_MB=50
MAX_VIDEO_SECONDS=300
MAX_NARRATION_CHARS=2000
MAX_QUEUE_SIZE=10
MAX_CONCURRENT_JOBS=1
JOB_RETENTION_HOURS=24
DOWNLOAD_TIMEOUT_SECONDS=120
SUBPROCESS_TIMEOUT_SECONDS=300

# ==========================================
# Audio-Video Speech Sync Configuration
# ==========================================
DUB_MAX_TEMPO=1.15
DUB_SYNC_START_TOLERANCE_MS=80
DUB_SYNC_END_TOLERANCE_MS=120
DUB_SYNC_FILTER_DURATION_TOLERANCE_MS=80
DUB_SYNC_GUARD_MS=0
DUB_SAMPLE_RATE=48000

