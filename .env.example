# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Pyrogram MTProto (សម្រាប់ Support Upload/Download វីដេអូធំៗរហូតដល់ 2GB)
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID_HERE
TELEGRAM_API_HASH=YOUR_TELEGRAM_API_HASH_HERE

# Google Gemini API Key (សម្រាប់ Transcription និង Motion Story Director)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Whisper Model Configuration (tiny, base, small, medium)
WHISPER_MODEL=base

# Default Language
LANGUAGE=km
